<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Keys mirror Dark.xaml exactly so the ThemeManager can swap. -->
    <Color x:Key="Color.Bg">#F4F5F7</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#EEF0F3</Color>
    <Color x:Key="Color.SurfaceHover">#E8EBEF</Color>
    <Color x:Key="Color.Border">#E3E6EB</Color>
    <Color x:Key="Color.BorderStrong">#D1D6DE</Color>
    <Color x:Key="Color.Text">#16181D</Color>
    <Color x:Key="Color.TextSecondary">#5B6371</Color>
    <Color x:Key="Color.TextTertiary">#8A909C</Color>
    <Color x:Key="Color.Accent">#5B5BD6</Color>
    <Color x:Key="Color.AccentHover">#4C4CC7</Color>
    <Color x:Key="Color.AccentPressed">#4141B0</Color>
    <Color x:Key="Color.AccentSoft">#ECECFB</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Success">#2E9E6B</Color>
    <Color x:Key="Color.SuccessSoft">#E4F4EC</Color>
    <Color x:Key="Color.Danger">#D64545</Color>
    <Color x:Key="Color.DangerHover">#C23B3B</Color>
    <Color x:Key="Color.DangerSoft">#FBEAEA</Color>
    <Color x:Key="Color.Warning">#C8891F</Color>
    <Color x:Key="Color.Shadow">#26000000</Color>
    <Color x:Key="Color.Overlay">#59000000</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />

</ResourceDictionary>
