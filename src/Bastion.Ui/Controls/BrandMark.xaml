<UserControl x:Class="Bastion.Ui.Controls.BrandMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="48" Height="48">
            <!-- Shield -->
            <Path Fill="{DynamicResource Brush.Accent}"
                  Data="M24,3 L41,9.5 L41,24.5 C41,35.5 33.6,42.6 24,45.6 C14.4,42.6 7,35.5 7,24.5 L7,9.5 Z" />
            <!-- Inner sheen for depth -->
            <Path Fill="#22FFFFFF"
                  Data="M24,3 L41,9.5 L41,24.5 C41,35.5 33.6,42.6 24,45.6 L24,3 Z" />
            <!-- Keyhole -->
            <Ellipse Canvas.Left="19" Canvas.Top="14" Width="10" Height="10" Fill="{DynamicResource Brush.OnAccent}" />
            <Polygon Points="22,20 26,20 27.6,32 20.4,32" Fill="{DynamicResource Brush.OnAccent}" />
        </Canvas>
    </Viewbox>
</UserControl>
