<Window x:Class="Bastion.Gatekeeper.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Bastion.Ui.Controls;assembly=Bastion.Ui"
        xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
        Title="Bastion" Width="404" Height="Auto" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource Font.Ui}">

    <Grid Margin="26">
        <Border x:Name="RootCard" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="16"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.97" ScaleY="0.97" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>

            <Grid Margin="30,26,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Close -->
                <Button x:Name="CloseButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{DynamicResource Btn.Icon}" Content="&#xE711;" Margin="0,-8,-8,0"
                        ToolTip="Cancel (Esc)" Click="Cancel_Click" />

                <!-- App icon -->
                <Border Grid.Row="1" Width="66" Height="66" CornerRadius="18" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Grid>
                        <Image x:Name="AppIcon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                        <ui:BrandMark x:Name="IconFallback" Width="34" Height="34" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Title + subtitle -->
                <TextBlock x:Name="AppName" Grid.Row="2" Style="{DynamicResource Text.Title}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,16,0,0" Text="Application" />
                <TextBlock x:Name="Subtitle" Grid.Row="3" Style="{DynamicResource Text.Secondary}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,5,0,0" Text="{loc:T GK_Subtitle}" />

                <!-- Password field -->
                <Border x:Name="PasswordArea" Grid.Row="4" Margin="0,22,0,0" Height="46" CornerRadius="10"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ShakeT" X="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="Password" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="14,0,0,0" FontSize="14"
                                     Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Accent}"
                                     PasswordChanged="Password_Changed" />
                        <TextBox x:Name="PasswordReveal" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="14,0,0,0" FontSize="14" Visibility="Collapsed"
                                 Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Accent}"
                                 TextChanged="Reveal_Changed" />
                        <TextBlock x:Name="Placeholder" Grid.Column="0" Text="{loc:T GK_Placeholder}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="15,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <ToggleButton x:Name="RevealToggle" Grid.Column="1" Width="40" Background="Transparent"
                                      Cursor="Hand" Click="Reveal_Click" ToolTip="Show password">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock x:Name="eye" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="eye" Property="Text" Value="&#xE7B3;" />
                                            <Setter TargetName="eye" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="eye" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- Feedback line -->
                <TextBlock x:Name="Feedback" Grid.Row="5" Style="{DynamicResource Text.Caption}" Margin="2,9,0,0"
                           Foreground="{DynamicResource Brush.Danger}" Visibility="Collapsed" />

                <!-- Actions -->
                <StackPanel Grid.Row="6" Margin="0,18,0,0">
                    <Button x:Name="UnlockButton" Style="{DynamicResource Btn.Primary}" Content="{loc:T GK_Unlock}"
                            HorizontalAlignment="Stretch" Click="Unlock_Click" />
                    <Button x:Name="HelloButton" Style="{DynamicResource Btn.Secondary}" HorizontalAlignment="Stretch"
                            Margin="0,10,0,0" Visibility="Collapsed" Click="Hello_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE928;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T GK_UseHello}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <ui:BrandMark Width="14" Height="14" Opacity="0.7" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:T GK_Footer}" Style="{DynamicResource Text.Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
