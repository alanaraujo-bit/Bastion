<Window x:Class="Bastion.App.ProtectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Bastion.App.Converters"
        xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
        Title="Bastion" Width="520" Height="628"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="{DynamicResource Font.Ui}">
    <Window.Resources>
        <conv:ExeIcon x:Key="ExeIcon" />
    </Window.Resources>
    <Grid Margin="20">
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="DialogTitle" Text="{loc:T Protect_Title}" Style="{DynamicResource Text.Title}" />
                        <TextBlock x:Name="DialogSubtitle" Text="{loc:T Protect_Sub}" Style="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Style="{DynamicResource Btn.Icon}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Click="Cancel_Click" />
                </Grid>

                <!-- STEP 1: pick -->
                <Grid x:Name="PickPanel" Grid.Row="1" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="Search" Grid.Row="0" Style="{DynamicResource Input}" Height="40" TextChanged="Search_Changed" />
                    <TextBlock Grid.Row="0" IsHitTestVisible="False" Text="{loc:T Protect_SearchApps}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}" x:Name="SearchPlaceholder" />

                    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Scanning" Text="{loc:T Protect_Scanning}" Style="{DynamicResource Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ListBox x:Name="Candidates" Background="Transparent" BorderThickness="0" Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Candidates_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="2,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Width="28" Height="28" Source="{Binding TargetPath, Converter={StaticResource ExeIcon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource Text.Body}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TargetPath}" Style="{DynamicResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2" Style="{DynamicResource Btn.Secondary}" Margin="0,12,0,0" Height="42" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T Protect_Browse}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- STEP 2: configure -->
                <StackPanel x:Name="ConfigPanel" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                    <Border CornerRadius="12" Background="{DynamicResource Brush.SurfaceAlt}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Brush.Surface}">
                                <Image x:Name="SelIcon" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelName" Style="{DynamicResource Text.Subtitle}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelPath" Style="{DynamicResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="DenyWarn" CornerRadius="10" Background="{DynamicResource Brush.DangerSoft}" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="DenyText" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Danger}" />
                    </Border>
                    <Border x:Name="StoreWarn" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Text="{loc:T Warn_Store}" Style="{DynamicResource Text.Secondary}" MaxWidth="380" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:T Protect_Unlock}" Style="{DynamicResource Text.Subtitle}" FontSize="13.5" Margin="2,20,0,8" />
                    <ComboBox x:Name="ModeCombo" Style="{DynamicResource Combo}" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="{loc:T Mode_Always}" />
                        <ComboBoxItem Content="{loc:T Mode_UntilClose}" />
                        <ComboBoxItem Content="{loc:T Mode_Minutes}" />
                        <ComboBoxItem Content="{loc:T Mode_Session}" />
                    </ComboBox>

                    <StackPanel x:Name="MinutesRow" Orientation="Horizontal" Margin="2,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="{loc:T Minutes_Keep}" Style="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        <ComboBox x:Name="MinutesCombo" Style="{DynamicResource Combo}" Width="130" Height="38" Margin="10,0,0,0">
                            <ComboBoxItem Tag="1" />
                            <ComboBoxItem Tag="5" IsSelected="True" />
                            <ComboBoxItem Tag="15" />
                            <ComboBoxItem Tag="30" />
                            <ComboBoxItem Tag="60" />
                        </ComboBox>
                    </StackPanel>

                    <Grid Margin="2,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:T Hello_Allow}" Style="{DynamicResource Text.Subtitle}" FontSize="13.5" />
                            <TextBlock Text="{loc:T Hello_AllowSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="HelloToggle" Style="{DynamicResource Switch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Button x:Name="BackBtn" Style="{DynamicResource Btn.Ghost}" Content="{loc:T Common_Back}" HorizontalAlignment="Left" Click="Back_Click" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_Cancel}" Click="Cancel_Click" Margin="0,0,10,0" />
                        <Button x:Name="ProtectBtn" Style="{DynamicResource Btn.Primary}" Content="{loc:T Protect_Btn}" Click="Protect_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
