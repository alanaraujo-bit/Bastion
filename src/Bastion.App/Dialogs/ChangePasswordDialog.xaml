<Window x:Class="Bastion.App.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
        Title="Bastion" Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="20">
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="16">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270" Opacity="0.26" Color="Black" /></Border.Effect>
            <StackPanel Margin="28,24,28,22">
                <TextBlock Text="{loc:T ChPwd_Title}" Style="{DynamicResource Text.Title}" />
                <TextBlock Text="{loc:T ChPwd_Sub}" Style="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />

                <TextBlock Text="{loc:T ChPwd_Current}" Style="{DynamicResource Text.Caption}" Margin="2,18,0,6" />
                <Border Height="44" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5">
                    <PasswordBox x:Name="Current" BorderThickness="0" Background="Transparent" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Accent}" />
                </Border>

                <TextBlock Text="{loc:T ChPwd_New}" Style="{DynamicResource Text.Caption}" Margin="2,14,0,6" />
                <Border Height="44" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5">
                    <PasswordBox x:Name="New1" BorderThickness="0" Background="Transparent" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Accent}" PasswordChanged="New_Changed" />
                </Border>
                <Border x:Name="StrengthTrack" Height="4" CornerRadius="2" Background="{DynamicResource Brush.SurfaceHover}" Margin="2,8,2,0">
                    <Border x:Name="StrengthFill" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource Brush.Danger}" Width="0" />
                </Border>

                <TextBlock Text="{loc:T ChPwd_Confirm}" Style="{DynamicResource Text.Caption}" Margin="2,12,0,6" />
                <Border Height="44" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5">
                    <PasswordBox x:Name="New2" BorderThickness="0" Background="Transparent" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Accent}" />
                </Border>

                <TextBlock x:Name="Error" Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="2,10,0,0" Visibility="Collapsed" />

                <Grid Margin="0,20,0,0">
                    <Button Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_Cancel}" HorizontalAlignment="Left" Width="120" Click="Cancel_Click" />
                    <Button x:Name="SaveBtn" Style="{DynamicResource Btn.Primary}" Content="{loc:T ChPwd_Update}" HorizontalAlignment="Right" Width="180" Click="Save_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
