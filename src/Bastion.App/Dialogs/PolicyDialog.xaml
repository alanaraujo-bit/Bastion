<Window x:Class="Bastion.App.PolicyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
        Title="Bastion" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="20">
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270" Opacity="0.26" Color="Black" />
            </Border.Effect>
            <StackPanel Margin="26,22,26,22">
                <TextBlock x:Name="TitleText" Text="{loc:T Policy_Title}" Style="{DynamicResource Text.Title}" />
                <TextBlock x:Name="AppText" Style="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />

                <TextBlock Text="{loc:T Protect_Unlock}" Style="{DynamicResource Text.Subtitle}" FontSize="13.5" Margin="0,20,0,8" />
                <ComboBox x:Name="ModeCombo" Style="{DynamicResource Combo}" SelectionChanged="Mode_Changed">
                    <ComboBoxItem Content="{loc:T Mode_Always}" />
                    <ComboBoxItem Content="{loc:T Mode_UntilClose}" />
                    <ComboBoxItem Content="{loc:T Mode_Minutes}" />
                    <ComboBoxItem Content="{loc:T Mode_Session}" />
                </ComboBox>

                <StackPanel x:Name="MinutesRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Minutes_Keep}" Style="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                    <ComboBox x:Name="MinutesCombo" Style="{DynamicResource Combo}" Width="140" Height="38" Margin="10,0,0,0">
                        <ComboBoxItem Tag="1" />
                        <ComboBoxItem Tag="5" />
                        <ComboBoxItem Tag="15" />
                        <ComboBoxItem Tag="30" />
                        <ComboBoxItem Tag="60" />
                    </ComboBox>
                </StackPanel>

                <Grid Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Hello_Allow}" Style="{DynamicResource Text.Subtitle}" FontSize="13.5" />
                        <TextBlock Text="{loc:T Hello_AllowSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton x:Name="HelloToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Policy_RelockLock}" Style="{DynamicResource Text.Subtitle}" FontSize="13.5" />
                        <TextBlock Text="{loc:T Policy_RelockLockSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton x:Name="LockToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Policy_RelockSleep}" Style="{DynamicResource Text.Subtitle}" FontSize="13.5" />
                        <TextBlock Text="{loc:T Policy_RelockSleepSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton x:Name="ResumeToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,24,0,0">
                    <Button Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_Cancel}" HorizontalAlignment="Left" Width="120" Click="Cancel_Click" />
                    <Button x:Name="SaveBtn" Style="{DynamicResource Btn.Primary}" Content="{loc:T Common_Save}" HorizontalAlignment="Right" Width="120" Click="Save_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
