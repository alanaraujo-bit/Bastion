<Window x:Class="Bastion.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
        Title="Bastion" Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="22">
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270" Opacity="0.26" Color="Black" />
            </Border.Effect>
            <StackPanel Margin="28,26,28,24">
                <Border x:Name="IconHost" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left">
                    <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{DynamicResource Text.Title}" Margin="0,16,0,0" Text="Are you sure?" />
                <TextBlock x:Name="MessageText" Style="{DynamicResource Text.Secondary}" Margin="0,6,0,0" Text="" />
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelBtn" Grid.Column="0" Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_Cancel}" Click="Cancel_Click" />
                    <Button x:Name="ConfirmBtn" Grid.Column="2" Style="{DynamicResource Btn.Primary}" Content="Confirm" Click="Confirm_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
