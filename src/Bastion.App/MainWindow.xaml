<Window x:Class="Bastion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Bastion.Ui.Controls;assembly=Bastion.Ui"
        xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bastion" Width="980" Height="668" MinWidth="880" MinHeight="600"
        Background="{DynamicResource Brush.Bg}" FontFamily="{DynamicResource Font.Ui}"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Center" Width="24" />
                                <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Nav rail ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,0,10">
                    <ui:BrandMark Width="26" Height="26" />
                    <TextBlock Text="Bastion" Style="{DynamicResource Text.Title}" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Footer: protection state -->
                <Border DockPanel.Dock="Bottom" Style="{DynamicResource Card}" Margin="12,10,12,14" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Protection active" Style="{DynamicResource Text.Subtitle}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:T GlobalProtection}" Style="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="GlobalToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" Click="GlobalToggle_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- ===== Content column ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Caption bar -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="SectionTitle" Text="Home" Style="{DynamicResource Text.Subtitle}" VerticalAlignment="Center" Margin="26,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{DynamicResource Btn.Icon}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{loc:T Tip_Minimize}" />
                    <Button x:Name="CloseBtn" Style="{DynamicResource Btn.Icon}" Content="&#xE711;" Click="Close_Click" ToolTip="{loc:T Tip_CloseTray}" />
                </StackPanel>
            </Grid>

            <!-- Service banner + page host -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="ServiceBanner" Grid.Row="0" Margin="26,0,26,4" Padding="14,10" CornerRadius="10"
                        Background="{DynamicResource Brush.DangerSoft}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T Banner_ServiceDown}"
                                   Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Danger}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ContentControl x:Name="PageHost" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
