<UserControl x:Class="Bastion.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Bastion.Ui.Controls;assembly=Bastion.Ui"
             xmlns:loc="clr-namespace:Bastion.Ui.Localization;assembly=Bastion.Ui"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,4,26,26">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <!-- ===== Security ===== -->
            <TextBlock Text="{loc:T Set_Security}" Style="{DynamicResource Text.Subtitle}" Margin="2,2,0,10" />
            <Border Style="{DynamicResource Card}" Padding="4">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel>
                            <TextBlock Text="{loc:T Set_Master}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T Set_MasterSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="ChangePwdBtn" Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_Change}" Height="36" HorizontalAlignment="Right" Click="ChangePwd_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />

                    <Grid Margin="16,14">
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock Text="{loc:T Set_Hello}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock x:Name="HelloDesc" Text="{loc:T Set_HelloSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="HelloToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Hello_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />

                    <Grid Margin="16,14">
                        <StackPanel Margin="0,0,180,0">
                            <TextBlock Text="{loc:T Set_DefaultBehaviour}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T Set_DefaultBehaviourSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="DefaultModeCombo" Style="{DynamicResource Combo}" Width="220" Height="38" HorizontalAlignment="Right" SelectionChanged="DefaultMode_Changed">
                            <ComboBoxItem Content="{loc:T Mode_Always}" />
                            <ComboBoxItem Content="{loc:T Behaviour_Short_UntilClose}" />
                            <ComboBoxItem Content="{loc:T Behaviour_Short_Minutes}" />
                            <ComboBoxItem Content="{loc:T Behaviour_Short_Session}" />
                        </ComboBox>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />

                    <Grid Margin="16,14">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="{loc:T Set_RequirePwd}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T Set_RequirePwdSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="ProtectChangesToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ProtectChanges_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />

                    <Grid Margin="16,14">
                        <StackPanel>
                            <TextBlock Text="{loc:T Set_Recovery}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock x:Name="RecoveryDesc" Text="{loc:T Set_RecoverySub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="RecoveryBtn" Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_SetUp}" Height="36" HorizontalAlignment="Right" Click="Recovery_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />

                    <Grid Margin="16,14">
                        <StackPanel Margin="0,0,210,0">
                            <TextBlock Text="{loc:T Set_Lockout}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T Set_LockoutSub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox x:Name="AttemptsCombo" Style="{DynamicResource Combo}" Width="118" Height="38" SelectionChanged="Lockout_Changed">
                                <ComboBoxItem Tag="3" />
                                <ComboBoxItem Tag="5" />
                                <ComboBoxItem Tag="10" />
                            </ComboBox>
                            <ComboBox x:Name="LockoutCombo" Style="{DynamicResource Combo}" Width="110" Height="38" Margin="8,0,0,0" SelectionChanged="Lockout_Changed">
                                <ComboBoxItem Tag="15" />
                                <ComboBoxItem Tag="30" />
                                <ComboBoxItem Tag="60" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Application ===== -->
            <TextBlock Text="{loc:T Set_Application}" Style="{DynamicResource Text.Subtitle}" Margin="2,24,0,10" />
            <Border Style="{DynamicResource Card}" Padding="4">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel><TextBlock Text="{loc:T Set_StartWin}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" /></StackPanel>
                        <ToggleButton x:Name="StartupToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="General_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel><TextBlock Text="{loc:T Set_StartMin}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" /></StackPanel>
                        <ToggleButton x:Name="StartMinToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="General_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel><TextBlock Text="{loc:T Set_CloseTray}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" /></StackPanel>
                        <ToggleButton x:Name="TrayToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="General_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel><TextBlock Text="{loc:T Set_Appearance}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" /></StackPanel>
                        <ComboBox x:Name="ThemeCombo" Style="{DynamicResource Combo}" Width="170" Height="38" HorizontalAlignment="Right" SelectionChanged="Theme_Changed">
                            <ComboBoxItem Content="{loc:T Theme_System}" />
                            <ComboBoxItem Content="{loc:T Theme_Light}" />
                            <ComboBoxItem Content="{loc:T Theme_Dark}" />
                        </ComboBox>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel><TextBlock Text="{loc:T Set_Language}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" /></StackPanel>
                        <ComboBox x:Name="LangCombo" Style="{DynamicResource Combo}" Width="200" Height="38" HorizontalAlignment="Right" SelectionChanged="Lang_Changed">
                            <ComboBoxItem Content="{loc:T Lang_System}" />
                            <ComboBoxItem Content="{loc:T Lang_En}" />
                            <ComboBoxItem Content="{loc:T Lang_Pt}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Privacy ===== -->
            <TextBlock Text="{loc:T Set_Privacy}" Style="{DynamicResource Text.Subtitle}" Margin="2,24,0,10" />
            <Border Style="{DynamicResource Card}" Padding="4">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="{loc:T Set_KeepHistory}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T Set_KeepHistorySub}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="HistoryToggle" Style="{DynamicResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="General_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel><TextBlock Text="{loc:T Set_ClearHistory}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" /></StackPanel>
                        <Button Style="{DynamicResource Btn.Secondary}" Content="{loc:T Common_Clear}" Height="36" HorizontalAlignment="Right" Click="ClearHistory_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== About ===== -->
            <TextBlock Text="{loc:T Set_About}" Style="{DynamicResource Text.Subtitle}" Margin="2,24,0,10" />
            <Border Style="{DynamicResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}">
                            <ui:BrandMark Width="30" Height="30" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Bastion" Style="{DynamicResource Text.Title}" />
                            <TextBlock x:Name="VersionText" Text="Application Lock · version 1.0.0" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{loc:T Set_AboutBlurb}" Style="{DynamicResource Text.Secondary}" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{DynamicResource Btn.Ghost}" Content="{loc:T Set_Licence}" Click="Licence_Click" />
                        <Button Style="{DynamicResource Btn.Ghost}" Content="{loc:T Set_HowItWorks}" Click="Docs_Click" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
